

# ---------------------------------------------------------
# 1. Import Libraries
# ---------------------------------------------------------

import pandas as pd
import matplotlib.pyplot as plt

from sklearn.datasets import load_iris
from sklearn.preprocessing import StandardScaler
from sklearn.cluster import KMeans
from sklearn.metrics import silhouette_score
from sklearn.decomposition import PCA


# ---------------------------------------------------------
# 2. Load the Dataset
# ---------------------------------------------------------

print("Loading Iris dataset...")

iris = load_iris()

# Create a DataFrame
data = pd.DataFrame(
    iris.data,
    columns=iris.feature_names
)

print("\nFirst five rows:")
print(data.head())

print("\nDataset shape:")
print(data.shape)


# ---------------------------------------------------------
# 3. Check the Dataset
# ---------------------------------------------------------

print("\nChecking for missing values:")
print(data.isnull().sum())

print("\nBasic statistics:")
print(data.describe())


# ---------------------------------------------------------
# 4. Select Features
# ---------------------------------------------------------

# We use all four numerical features for clustering
X = data[
    [
        "sepal length (cm)",
        "sepal width (cm)",
        "petal length (cm)",
        "petal width (cm)"
    ]
]


# ---------------------------------------------------------
# 5. Scale the Data
# ---------------------------------------------------------

# K-Means uses distance, so scaling the features is helpful
scaler = StandardScaler()

X_scaled = scaler.fit_transform(X)

print("\nData has been standardized successfully.")


# ---------------------------------------------------------
# 6. Find the Number of Clusters
# ---------------------------------------------------------

inertia_values = []
silhouette_values = []

# Test different numbers of clusters
for k in range(2, 8):

    model = KMeans(
        n_clusters=k,
        random_state=42,
        n_init=10
    )

    labels = model.fit_predict(X_scaled)

    # Store WCSS/Inertia
    inertia_values.append(model.inertia_)

    # Store Silhouette Score
    score = silhouette_score(X_scaled, labels)
    silhouette_values.append(score)

    print(
        "Clusters:",
        k,
        "| Inertia:",
        round(model.inertia_, 2),
        "| Silhouette Score:",
        round(score, 3)
    )


# ---------------------------------------------------------
# 7. Elbow Method Graph
# ---------------------------------------------------------

k_values = range(2, 8)

plt.figure(figsize=(7, 5))

plt.plot(
    k_values,
    inertia_values,
    marker="o"
)

plt.xlabel("Number of Clusters")
plt.ylabel("Inertia / WCSS")
plt.title("Elbow Method")

plt.grid(True)

plt.show()


# ---------------------------------------------------------
# 8. Silhouette Score Graph
# ---------------------------------------------------------

plt.figure(figsize=(7, 5))

plt.plot(
    k_values,
    silhouette_values,
    marker="o"
)

plt.xlabel("Number of Clusters")
plt.ylabel("Silhouette Score")
plt.title("Silhouette Score")

plt.grid(True)

plt.show()


# ---------------------------------------------------------
# 9. Apply K-Means
# ---------------------------------------------------------

# Based on the analysis, we use 3 clusters
number_of_clusters = 3

kmeans = KMeans(
    n_clusters=number_of_clusters,
    random_state=42,
    n_init=10
)

clusters = kmeans.fit_predict(X_scaled)


# Add cluster numbers to the dataset
data["Cluster"] = clusters + 1


# ---------------------------------------------------------
# 10. Display Cluster Information
# ---------------------------------------------------------

print("\nCluster Count:")

print(
    data["Cluster"].value_counts().sort_index()
)


# ---------------------------------------------------------
# 11. Calculate Cluster Averages
# ---------------------------------------------------------

print("\nAverage values for each cluster:")

cluster_summary = data.groupby("Cluster")[
    [
        "sepal length (cm)",
        "sepal width (cm)",
        "petal length (cm)",
        "petal width (cm)"
    ]
].mean()

print(cluster_summary)


# ---------------------------------------------------------
# 12. PCA for Visualization
# ---------------------------------------------------------

# PCA converts the four features into two components
# so that we can visualize the clusters in a 2D graph.

pca = PCA(n_components=2)

X_pca = pca.fit_transform(X_scaled)


# ---------------------------------------------------------
# 13. Plot the Clusters
# ---------------------------------------------------------

plt.figure(figsize=(8, 6))

for cluster in range(1, number_of_clusters + 1):

    cluster_data = X_pca[
        data["Cluster"] == cluster
    ]

    plt.scatter(
        cluster_data[:, 0],
        cluster_data[:, 1],
        label="Cluster " + str(cluster)
    )


plt.xlabel("Principal Component 1")
plt.ylabel("Principal Component 2")

plt.title("Iris Dataset - K-Means Clustering")

plt.legend()

plt.grid(True)

plt.show()


# ---------------------------------------------------------
# 14. Save the Results
# ---------------------------------------------------------

data.to_csv(
    "iris_clustering_results.csv",
    index=False
)

print("\nClustering results saved successfully!")

print("\nProject completed.")
